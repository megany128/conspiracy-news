# Copy to .env.local and fill in.

# Required — used by both the Ara tools and the local web server
ANTHROPIC_API_KEY=sk-ant-...

# Required for `ara deploy` / `ara run`
ARA_API_KEY=

# Populated AFTER you run `ara deploy app.py` — needed by server.py to send
# iMessage via the Ara run API. `ara deploy` prints both.
ARA_APP_ID=
ARA_RUNTIME_KEY=ak_app_...

# Optional
# ARA_API_BASE=https://api.ara.so
# PORT=8787
# CONSPIRACY_MODEL=claude-sonnet-4-5
